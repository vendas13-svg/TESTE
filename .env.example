# ── Chave da API Anthropic (Claude AI) ─────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Seu número do WhatsApp (somente números, com DDI) ──────────────────────────
# Exemplo: 5511999999999  (55 = Brasil, 11 = SP, 999999999 = número)
OWNER_NUMBER=5511999999999

# ── Resposta automática para perguntas simples ─────────────────────────────────
# true  = bot responde automaticamente às perguntas
# false = apenas monitora e loga (recomendado para começar)
AUTO_REPLY=false

# ── Contatos VIP (separados por vírgula, somente números) ─────────────────────
# Mensagens desses contatos sempre terão prioridade ALTA
# Exemplo: 5511999999999,5521888888888
VIP_CONTACTS=

# ── Intervalo do resumo automático (em horas) ──────────────────────────────────
# O agente enviará um resumo das mensagens para OWNER_NUMBER a cada X horas
SUMMARY_INTERVAL_HOURS=6
